<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/welcomeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Elemento decorativo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛍️"
            android:textSize="76sp"
            android:layout_marginBottom="20dp"/>

        <!-- Nombre de la aplicación -->
        <TextView
            android:id="@+id/txtAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MY RETAIL"
            android:textColor="@color/text_primary"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:gravity="center"/>

        <!-- Acento corporativo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★  RECONOCEMOS TU TALENTO  ★"
            android:textColor="@color/myretail_gold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="10dp"
            android:gravity="center"/>

        <!-- Mensaje de bienvenida -->
        <TextView
            android:id="@+id/txtWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Bienvenido al equipo!"
            android:textColor="@color/myretail_orange"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="40dp"/>

        <!-- Descripción -->
        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Celebramos los logros, el esfuerzo y el talento de nuestros vendedores.\n\n¡Es hora de brillar!"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="16dp"/>

        <!-- Decoración -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆     ⭐     🥇"
            android:textSize="30sp"
            android:layout_marginTop="28dp"/>

        <!-- Botón principal -->
        <Button
            android:id="@+id/btnVerEquipo"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="VER EQUIPO"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/myretail_orange"
            android:layout_marginTop="36dp"/>

        <!-- Pie -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MY RETAIL  •  VENTAS &amp; RECONOCIMIENTO"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:letterSpacing="0.10"
            android:layout_marginTop="32dp"
            android:gravity="center"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
